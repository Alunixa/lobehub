#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

start_service() {
  config_load lobe-host-executor

  local enabled host port root token
  config_get_bool enabled main enabled 0
  [ "$enabled" -eq 1 ] || return 0

  config_get host main host 172.17.0.1
  config_get port main port 3211
  config_get root main root /mnt/sda1/lobehub-host-runtime
  config_get token main token

  [ "${#token}" -ge 32 ] || {
    logger -t lobe-host-executor "token must contain at least 32 characters"
    return 1
  }

  procd_open_instance
  procd_set_param command /usr/bin/node /opt/lobe-host-executor/server.mjs
  procd_set_param env \
    "HOST_EXECUTOR_HOST=$host" \
    "HOST_EXECUTOR_PORT=$port" \
    "HOST_EXECUTOR_ROOT=$root" \
    "HOST_EXECUTOR_TOKEN=$token"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits core="0"
  procd_close_instance
}

service_triggers() {
  procd_add_reload_trigger lobe-host-executor
}
